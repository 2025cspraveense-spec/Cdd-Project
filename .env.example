# =============================================================================
# Secret Leak Guard v2.0 - Environment Configuration Template
# Copy this file to .env and configure values before starting Docker Compose
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Security Secrets
# -----------------------------------------------------------------------------
FLASK_ENV=production
DEBUG=False
PORT=5000

# Cryptographic Keys (Change in production!)
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# 2. Database Configuration (MongoDB 7.0)
# -----------------------------------------------------------------------------
# Root credentials are used by MongoDB initialization and Vault's database plugin.
MONGO_INITDB_ROOT_USERNAME=slg_root
MONGO_INITDB_ROOT_PASSWORD=
# Least-privilege KV-v2 fallback account; dynamic leases are preferred.
MONGO_APP_USERNAME=slg_backend_fallback
MONGO_APP_PASSWORD=
# Backend URI is credential-free; Mongo auth is supplied by a Vault database lease.
MONGO_URI=mongodb://mongodb:27017/secret_leak_guard_v2
MONGO_DB_NAME=secret_leak_guard_v2
MONGO_AUTH_SOURCE=secret_leak_guard_v2
MONGO_TTL_SECONDS=2592000
MONGO_USE_MOCK=false

# -----------------------------------------------------------------------------
# 3. HashiCorp Vault 1.15.6 (KV-v2 Secrets Engine)
# -----------------------------------------------------------------------------
VAULT_ENABLED=true
# Seeds missing KV-v2 keys from this file on first start; existing Vault values win.
VAULT_BOOTSTRAP_ENV=true
# Inside docker-compose slg-network, use 'http://vault:8200'
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=secret-leak-guard
VAULT_TIMEOUT=5
VAULT_DATABASE_ROLE=slg-backend-role
# KV-v2 MONGO_URI is used only if dynamic credential generation fails.
VAULT_DATABASE_FALLBACK=true

# -----------------------------------------------------------------------------
# 4. Optional AI Security Assistant
# -----------------------------------------------------------------------------
# Choose "groq" or "gemini" and configure its matching key. Keys can also be
# seeded in Vault KV-v2. AI requests require per-request consent and receive
# redacted scan/finding metadata only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 5. Scanner Engine & Workspace Settings
# -----------------------------------------------------------------------------
WORKSPACE_BASE_DIR=/tmp/scanner_workspaces
ALLOWED_LOCAL_SCAN_PATHS=/tmp/scanner_workspaces,/scan_targets
MAX_CONTENT_LENGTH=1048576000
ALLOWED_ARCHIVE_EXTENSIONS=.zip,.tar.gz,.tgz,.tar

# Concurrency & Rate Limiting
ENGINE_MAX_WORKERS=4
SCAN_JOB_TIMEOUT_SECONDS=300
RATELIMIT_DEFAULT="100 per minute"
RATELIMIT_STORAGE_URI=memory://

# -----------------------------------------------------------------------------
# 6. Reverse Proxy & Networking Ports
# -----------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_ALT_PORT=8080
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_PORT=27017
VAULT_PORT=8200
